{
  "name": "dut-bench",
  "description": "One matrix fanning instruments and supplies onto twelve DUT pins, with a thermocouple multiplexer patched onto matrix column 13 and a multiway RTD mux on column 14. Sized and named to be read, not to model any particular product.",
  "cards": {
    "matrix_a": {
      "bus": 4,
      "device": 14,
      "card_id": "SIM-MATRIX-8x16",
      "subunits": [
        {
          "subunit": 1,
          "type": "MATRIX",
          "rows": 8,
          "columns": 16,
          "closure_limit": 12,
          "settle_time_us": 3000
        }
      ]
    },
    "mux_b": {
      "bus": 4,
      "device": 15,
      "card_id": "SIM-MUX-1x16-PLUS-1x8",
      "subunits": [
        {
          "subunit": 1,
          "type": "MUX",
          "rows": 1,
          "columns": 16,
          "closure_limit": 1,
          "settle_time_us": 2000
        },
        {
          "subunit": 2,
          "type": "MUXM",
          "rows": 1,
          "columns": 8,
          "closure_limit": 4,
          "settle_time_us": 2000
        }
      ]
    }
  },
