{
  "name": "power: a legitimate path carrying an illegitimate level",
  "steps": [
    {
      "id": "res",
      "tool": "reserve_chassis",
      "args": {
        "owner": "walkthrough"
      },
      "expect": {
        "owner": "walkthrough"
      }
    },
    {
      "id": "arm",
      "tool": "arm_interlock",
      "args": {
        "token": "{{res.token}}",
        "confirm": "the fixture is safe to energise"
      },
      "expect": {
        "armed": true
      }
    },
    {
      "id": "gen",
      "tool": "route_signal",
      "args": {
        "token": "{{res.token}}",
        "from_endpoint": "awg_out",
        "to_endpoint": "dut_pin_a6"
      },
      "expect": {
        "status": "open"
      }
    },
    {
      "id": "elsewhere",
      "tool": "route_signal",
      "args": {
        "token": "{{res.token}}",
        "from_endpoint": "scope_ch1",
        "to_endpoint": "dut_pin_a2"
      },
      "expect": {
        "status": "open"
      }
    },
    {
      "id": "overload",
      "tool": "route_signal",
      "args": {
        "token": "{{res.token}}",
        "from_endpoint": "scope_ch2",
        "to_endpoint": "dut_pin_a6"
      },
      "expect_error": "InterlockError"
    },
    {
      "id": "intact",
      "tool": "subunit_state",
      "args": {
        "card": "matrix_a",
        "subunit": 1
      },
      "expect": {
        "closed_count": 2
      }
    },
    {
      "id": "why",
      "tool": "plan_route",
      "args": {
        "from_endpoint": "scope_ch2",
        "to_endpoint": "dut_pin_a6"
      },
      "expect": {
        "permitted": false,
        "hops": 1
      }
    },
    {
      "id": "drop",
      "tool": "unroute_signal",
      "args": {
        "token": "{{res.token}}",
        "from_endpoint": "awg_out",
        "to_endpoint": "dut_pin_a6"
      },
      "expect": {
        "status": "closed"
      }
    },
    {
      "id": "nowfine",
      "tool": "route_signal",
      "args": {
        "token": "{{res.token}}",
        "from_endpoint": "scope_ch2",
        "to_endpoint": "dut_pin_a6"
      },
      "expect": {
        "status": "open"
      }
    },
    {
      "id": "free",
      "tool": "release_chassis",
      "args": {
        "token": "{{res.token}}"
      },
      "expect": {
        "status": "released"
      }
    }
  ]
}
