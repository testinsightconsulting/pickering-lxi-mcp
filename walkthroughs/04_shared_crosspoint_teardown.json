{
  "name": "teardown: two routes sharing a crosspoint, and only one of them let go",
  "steps": [
    { "id": "res",   "tool": "reserve_chassis", "args": { "owner": "walkthrough" }, "expect": { "owner": "walkthrough" } },
    { "id": "arm",   "tool": "arm_interlock", "args": { "token": "{{res.token}}", "confirm": "the fixture is safe to energise" }, "expect": { "armed": true } },

    { "id": "a",     "tool": "route_signal", "args": { "token": "{{res.token}}", "from_endpoint": "dmm_hi", "to_endpoint": "rtd_1" },
                     "expect": { "operations": [ { "card": "matrix_a", "subunit": 1, "row": 6, "column": 14 },
                                                 { "card": "mux_b", "subunit": 2, "row": 1, "column": 1 } ] } },
    { "id": "b",     "tool": "route_signal", "args": { "token": "{{res.token}}", "from_endpoint": "dmm_hi", "to_endpoint": "rtd_2" },
                     "expect": { "operations": [ { "card": "matrix_a", "subunit": 1, "row": 6, "column": 14 },
                                                 { "card": "mux_b", "subunit": 2, "row": 1, "column": 2 } ] } },
    { "id": "both",  "tool": "crosspoint_state", "args": { "card": "matrix_a", "subunit": 1, "row": 6, "column": 14 },
                     "expect": { "closed": true, "held_by_routes": ["dmm_hi<->rtd_1", "dmm_hi<->rtd_2"] } },

    { "id": "dropa", "tool": "unroute_signal", "args": { "token": "{{res.token}}", "from_endpoint": "dmm_hi", "to_endpoint": "rtd_1" },
                     "expect": { "opened": [ { "card": "mux_b", "subunit": 2, "row": 1, "column": 1 } ],
                                 "retained_for_other_routes": [ { "card": "matrix_a", "subunit": 1, "row": 6, "column": 14 } ] } },
    { "id": "keptup","tool": "crosspoint_state", "args": { "card": "matrix_a", "subunit": 1, "row": 6, "column": 14 },
                     "expect": { "closed": true, "held_by_routes": ["dmm_hi<->rtd_2"] } },

    { "id": "dropb", "tool": "unroute_signal", "args": { "token": "{{res.token}}", "from_endpoint": "dmm_hi", "to_endpoint": "rtd_2" },
                     "expect": { "retained_for_other_routes": [] } },
    { "id": "gone",  "tool": "crosspoint_state", "args": { "card": "matrix_a", "subunit": 1, "row": 6, "column": 14 },
                     "expect": { "closed": false, "held_by_routes": [] } },

    { "id": "free",  "tool": "release_chassis", "args": { "token": "{{res.token}}" }, "expect": { "status": "released" } }
  ]
}
